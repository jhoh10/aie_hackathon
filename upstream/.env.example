# Copy to .env and fill in. List variable names only, never real values.

# Verifier model step (verifier/src/model.ts). With no key it reads saved answers from verifier/.work/gen.
# Meta Model API key from https://dev.meta.ai (Muse Spark). MODEL_API_KEY works too and wins if both are set.
META_API_KEY=
MODEL_API_KEY=
# Optional overrides. Defaults: https://api.meta.ai/v1 and muse-spark-1.3 (standard model, not -contributor).
MODEL_BASE_URL=
MODEL_NAME=
# Set to "files" to force saved answers even when a key is set.
MODEL=
