+def _check_regexp_csv(value: list[str] | tuple[str] | str) -> Iterable[str]:
+    r"""Split a comma-separated list of regexps, ignoring commas inside
+    braces (``{1,3}``), character classes (``[a,b]``) and groups (``(a,b)``),
+    as well as escaped commas, so valid regexps are not mangled.
+    """
+    if isinstance(value, (list, tuple)):
+        yield from value
+        return
+    current: list[str] = []
+    parens = 0
+    in_braces = False
+    in_class = False
+    escaped = False
+    for char in value:
+        was_escaped = escaped
+        if escaped:
+            escaped = False
+        elif char == "\\":
+            escaped = True
+        elif in_class:
+            if char == "]":
+                in_class = False
+        elif char == "[":
+            in_class = True
+        elif char == "{":
+            in_braces = True
+        elif char == "}":
+            in_braces = False
+        elif char == "(":
+            parens += 1
+        elif char == ")" and parens:
+            parens -= 1
+        if char == "," and not (was_escaped or in_class or in_braces or parens):
+            part = "".join(current).strip()
+            if part:
+                yield part
+            current = []
+        else:
+            current.append(char)
+    part = "".join(current).strip()
+    if part:
+        yield part
+
+
 def _comment(string: str) -> str:
