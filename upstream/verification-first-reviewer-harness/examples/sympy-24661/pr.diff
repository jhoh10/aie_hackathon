+    relational_operators = {
+        ast.Lt: 'Lt',
+        ast.Gt: 'Gt',
+        ast.LtE: 'Le',
+        ast.GtE: 'Ge',
+        ast.Eq: 'Eq',
+        ast.NotEq: 'Ne',
+    }
+
+    def visit_Compare(self, node):
+        if not all(op.__class__ in self.relational_operators
+                   for op in node.ops):
+            # e.g. ``in`` or ``is``: no SymPy relational equivalent
+            return self.generic_visit(node)
+        operands = [self.visit(node.left)] + [self.visit(c)
+                                              for c in node.comparators]
+        rels = [
+            ast.Call(
+                func=ast.Name(id=self.relational_operators[op.__class__],
+                              ctx=ast.Load()),
+                args=[lhs, rhs],
+                keywords=[ast.keyword(arg='evaluate',
+                    value=ast.NameConstant(value=False, ctx=ast.Load()))],
+                starargs=None,
+                kwargs=None)
+            for op, lhs, rhs in zip(node.ops, operands, operands[1:])]
+        if len(rels) == 1:
+            return rels[0]
+        # chained comparison ``a < b < c`` means ``(a < b) and (b < c)``
+        return ast.Call(
+            func=ast.Name(id='And', ctx=ast.Load()),
+            args=rels,
+            keywords=[ast.keyword(arg='evaluate',
+                value=ast.NameConstant(value=False, ctx=ast.Load()))],
+            starargs=None,
+            kwargs=None)
