+
+def test_evaluate_false_relationals():
+    from sympy.core.relational import Lt, Gt, Le, Ge, Ne
+    from sympy import Add
+    x, y = Symbol('x'), Symbol('y')
+    # every operator, unevaluated
+    for text, cls in [('1 < 2', Lt), ('1 > 2', Gt), ('1 <= 2', Le),
+                      ('1 >= 2', Ge), ('1 == 2', Eq), ('1 != 2', Ne)]:
+        res = parse_expr(text, evaluate=False)
+        assert res is not True and res is not False
+        assert isinstance(res, cls)
+        assert res.args == (1, 2)
+    assert parse_expr('1 < 2', evaluate=False) == Lt(1, 2, evaluate=False)
+    # symbolic / nested operands
+    assert parse_expr('x < y', evaluate=False) == Lt(x, y, evaluate=False)
+    assert parse_expr('x + 1 > y', evaluate=False) == Gt(
+        Add(x, 1, evaluate=False), y, evaluate=False)
+    # with boolean ops
+    assert parse_expr('(1 < 2) & (3 > 2)', evaluate=False) == And(
+        Lt(1, 2, evaluate=False), Gt(3, 2, evaluate=False), evaluate=False)
+    # chained comparison
+    res = parse_expr('1 < 2 < 3', evaluate=False)
+    assert res is not True
+    assert res == And(Lt(1, 2, evaluate=False), Lt(2, 3, evaluate=False),
+                      evaluate=False)
+    # default path unchanged
+    assert parse_expr('1 < 2') is S.true
+    assert parse_expr('x < y') == Lt(x, y)
