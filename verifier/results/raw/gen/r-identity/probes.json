{
  "scenarios": [
    {
      "id": "p1_username_first_email_collision",
      "claim": null,
      "kind": "probe",
      "steps": [
        {
          "id": "create_coll",
          "setup": true,
          "method": "POST",
          "path": "/api/collections",
          "as": "superuser",
          "json": {
            "name": "members",
            "type": "auth",
            "listRule": "",
            "viewRule": "",
            "createRule": "",
            "updateRule": "",
            "deleteRule": "",
            "fields": [
              {
                "name": "username",
                "type": "text"
              }
            ],
            "indexes": [
              "CREATE UNIQUE INDEX idx_members_username ON members (username)"
            ],
            "passwordAuth": {
              "enabled": true,
              "identityFields": [
                "username",
                "email"
              ]
            }
          },
          "expect": {
            "status": 200
          }
        },
        {
          "id": "member_a",
          "setup": true,
          "method": "POST",
          "path": "/api/collections/members/records",
          "as": "superuser",
          "json": {
            "email": "alpha@probe.io",
            "username": "beta@probe.io",
            "password": "passwordA123",
            "passwordConfirm": "passwordA123"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "id": "member_b",
          "setup": true,
          "method": "POST",
          "path": "/api/collections/members/records",
          "as": "superuser",
          "json": {
            "email": "beta@probe.io",
            "username": "betauser",
            "password": "passwordB123",
            "passwordConfirm": "passwordB123"
          },
          "expect": {
            "status": 200
          }
        },
        {
          "id": "pw_a",
          "method": "POST",
          "path": "/api/collections/members/auth-with-password?fields=record.email,record.username",
          "as": "anon",
          "json": {
            "identity": "beta@probe.io",
            "password": "passwordA123"
          }
        },
        {
          "id": "pw_b",
          "method": "POST",
          "path": "/api/collections/members/auth-with-password?fields=record.email,record.username",
          "as": "anon",
          "json": {
            "identity": "beta@probe.io",
            "password": "passwordB123"
          }
        },
        {
          "id": "by_username",
          "method": "POST",
          "path": "/api/collections/members/auth-with-password?fields=record.email,record.username",
          "as": "anon",
          "json": {
            "identity": "betauser",
            "password": "passwordB123"
          }
        }
      ]
    },
