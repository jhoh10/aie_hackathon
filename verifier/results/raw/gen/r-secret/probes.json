          "id": "patch_no_secret",
          "method": "PATCH",
          "path": "/api/collections/members",
          "as": "superuser",
          "json": {
            "oauth2": {
              "providers": [
                {
                  "name": "google",
                  "clientId": "gid2"
                }
              ]
            }
          }
        },
        {
          "id": "get_coll",
          "method": "GET",
          "path": "/api/collections/members?fields=oauth2",
