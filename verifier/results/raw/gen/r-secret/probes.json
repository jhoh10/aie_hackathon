      "kind": "probe",
      "steps": [
        {
          "id": "create_coll",
          "setup": true,
          "method": "POST",
          "path": "/api/collections",
          "as": "superuser",
          "json": {
            "name": "members",
            "type": "auth",
            "listRule": "",
            "viewRule": "",
            "createRule": "",
            "updateRule": "",
            "deleteRule": "",
            "oauth2": {
              "enabled": true,
              "providers": [
                {
                  "name": "google",
                  "clientId": "gid",
                  "clientSecret": "gsecret"
                }
              ]
            }
          },
          "expect": {
            "status": 200
