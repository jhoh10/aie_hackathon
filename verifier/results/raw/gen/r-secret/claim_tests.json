   "kind": "claim",
   "steps": [
    {
     "id": "s1a",
     "method": "POST",
     "path": "/api/collections",
     "as": "superuser",
     "json": {
      "name": "journals",
      "type": "base",
      "listRule": "",
      "viewRule": "@request.auth.id != \"\"",
      "createRule": null,
      "updateRule": null,
      "deleteRule": null,
      "fields": [
       {
        "name": "heading",
        "type": "text",
        "max": 120
       },
       {
        "name": "mood",
        "type": "number",
        "min": 1,
        "max": 5,
        "onlyInt": true
       }
      ],
      "indexes": [
       "CREATE INDEX idx_journals_heading ON journals (heading)"
      ]
     },
     "expect": {
      "status": 200,
      "paths": {
       "name": "journals",
       "type": "base",
       "listRule": "",
       "viewRule": "@request.auth.id != \"\"",
       "createRule": null,
       "deleteRule": null,
       "fields.1.name": "heading",
       "fields.1.type": "text",
       "fields.1.max": 120,
       "fields.2.name": "mood",
       "fields.2.onlyInt": true,
       "fields.2.max": 5,
       "indexes.0": "CREATE INDEX idx_journals_heading ON journals (heading)"
      }
     },
     "save": {
      "jid": "id"
     }
    },
    {
     "id": "s1b",
     "method": "GET",
     "path": "/api/collections/{{jid}}",
     "as": "superuser",
     "expect": {
      "status": 200,
      "paths": {
       "name": "journals",
       "type": "base",
       "listRule": "",
       "updateRule": null,
       "fields.2.min": 1,
       "indexes.0": "CREATE INDEX idx_journals_heading ON journals (heading)"
      }
     }
    }
   ]
