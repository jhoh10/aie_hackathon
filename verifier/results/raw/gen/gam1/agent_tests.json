{
 "scenarios": [
  {
   "id": "username-only-identity-email-like",
   "claim": "c1",
   "kind": "claim",
   "steps": [
    {
     "id": "create-col",
     "setup": true,
     "method": "POST",
     "path": "/api/collections",
     "as": "superuser",
     "json": {
      "name": "gmembers1",
      "type": "auth",
      "fields": [
       {
        "name": "username",
        "type": "text"
       }
      ],
      "indexes": [
       "CREATE UNIQUE INDEX idx_gmembers1_username ON gmembers1 (username)"
      ],
      "passwordAuth": {
       "enabled": true,
       "identityFields": [
        "username"
       ]
      }
     },
     "expect": {
      "status": 200
     }
    },
    {
     "id": "create-rec",
     "setup": true,
     "method": "POST",
     "path": "/api/collections/gmembers1/records",
     "as": "superuser",
     "json": {
      "email": "real1@example.com",
      "username": "uname1@mailbox.io",
      "password": "Passw0rd123!",
      "passwordConfirm": "Passw0rd123!"
     },
     "expect": {
      "status": 200
     }
    },
    {
     "id": "auth-by-username",
     "method": "POST",
     "path": "/api/collections/gmembers1/auth-with-password",
     "as": "anon",
     "json": {
      "identity": "uname1@mailbox.io",
      "password": "Passw0rd123!"
     },
     "expect": {
      "status": 200,
      "json": {
       "record": {
        "email": "real1@example.com",
        "username": "uname1@mailbox.io"
       }
      }
     }
    }
   ]
  },
