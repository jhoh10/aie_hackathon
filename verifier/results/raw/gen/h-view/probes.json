    {
      "id": "p1_wildcard_queries",
      "claim": null,
      "kind": "probe",
      "steps": [
        {
          "id": "create_posts",
          "setup": true,
          "method": "POST",
          "path": "/api/collections",
          "as": "superuser",
          "json": {
            "name": "posts",
            "type": "base",
            "listRule": "",
            "viewRule": "",
            "createRule": "",
            "updateRule": "",
            "deleteRule": "",
            "fields": [
              {
                "id": "fldid00001",
                "name": "id",
                "type": "text",
                "system": true,
                "primaryKey": true,
                "required": true,
                "min": 15,
                "max": 15,
                "pattern": "^[a-z0-9]+$",
                "autogeneratePattern": "[a-z0-9]{15}"
              },
              {
                "id": "fldtitle01",
                "name": "title",
                "type": "text"
              },
              {
                "id": "fldscore01",
                "name": "score",
                "type": "number",
                "min": 0,
                "max": 10
              }
            ]
          },
          "expect": {
            "status": 200
          }
        },
        {
          "id": "star",
          "method": "POST",
          "path": "/api/collections",
          "as": "superuser",
          "json": {
            "name": "v1",
            "type": "view",
            "listRule": "",
            "viewRule": "",
            "viewQuery": "SELECT * FROM posts"
          }
        },
        {
          "id": "table_star",
