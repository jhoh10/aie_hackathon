          "json": {
            "name": "v3",
            "type": "view",
            "listRule": "",
            "viewRule": "",
            "viewQuery": "SELECT p.* FROM posts p"
          }
        },
        {
          "id": "star_plus_id",
          "method": "POST",
          "path": "/api/collections",
          "as": "superuser",
          "json": {
            "name": "v4",
            "type": "view",
            "listRule": "",
            "viewRule": "",
            "viewQuery": "SELECT id, * FROM posts"
          }
        },
        {
          "id": "count_star",
          "method": "POST",
          "path": "/api/collections",
          "as": "superuser",
          "json": {
            "name": "v5",
            "type": "view",
            "listRule": "",
            "viewRule": "",
            "viewQuery": "SELECT id, count(*) as total FROM posts GROUP BY id"
          }
        }
      ]
