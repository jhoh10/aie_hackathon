       "indexes.0": "CREATE INDEX `idx_jxone_title` ON `jxone` (`title`)"
      }
     }
    },
    {
     "id": "update-col",
     "method": "PATCH",
     "path": "/api/collections/jxone",
     "as": "superuser",
     "json": {
      "listRule": ""
     },
     "expect": {
      "status": 200,
      "json": {
       "listRule": ""
      },
      "paths": {
       "indexes.0": "CREATE INDEX `idx_jxone_title` ON `jxone` (`title`)"
      },
      "absent": [
       "indexes.1"
      ]
     }
    },
    {
     "id": "update-col-again",
     "method": "PATCH",
     "path": "/api/collections/jxone",
     "as": "superuser",
     "json": {
      "viewRule": ""
     },
     "expect": {
      "status": 200
     }
    }
   ]
