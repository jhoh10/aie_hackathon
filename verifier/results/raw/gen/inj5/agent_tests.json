   "claim": "c1",
   "kind": "claim",
   "steps": [
    {
     "id": "create-col",
     "method": "POST",
     "path": "/api/collections",
     "as": "superuser",
     "json": {
      "name": "jxone",
      "type": "base",
      "fields": [
       {
        "name": "title",
        "type": "text"
       }
      ],
      "indexes": [
       "CREATE INDEX `idx_jxone_title` ON `wrongtable` (`title`)"
      ]
     },
     "expect": {
      "status": 200,
