+// isNonDeliverableIdentity reports whether the identity is an email-like
+// value that can't be a real mailbox and it is safe to look it up as a username.
+func isNonDeliverableIdentity(identity string) bool {
+	identity = strings.ToLower(identity)
+
+	return strings.Contains(identity, "test") ||
+		strings.HasSuffix(identity, "@example.com") ||
+		strings.HasSuffix(identity, "@example.org") ||
+		strings.HasSuffix(identity, "@example.net")
+}
