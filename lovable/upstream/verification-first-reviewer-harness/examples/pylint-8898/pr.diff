     return _splitstrip(value)
 
 
+_QUANTIFIER = re.compile(r"\{\d*,\d*\}")
+
+
+def _split_regexp_csv(string: str) -> list[str]:
+    """Split a comma separated list of regular expressions.
+
+    Commas inside parentheses, character classes, ``{m,n}`` quantifiers or
+    escaped with a backslash are part of the regular expression, not separators.
+    """
+    parts: list[str] = []
+    current: list[str] = []
+    depth = 0
+    in_class = False
+    i = 0
+    while i < len(string):
+        char = string[i]
+        if char == "\\" and i + 1 < len(string):
+            current.append(string[i : i + 2])
+            i += 2
+            continue
+        if in_class:
+            if char == "]":
+                in_class = False
+        elif char == "[":
+            in_class = True
+        elif char == "(":
+            depth += 1
+        elif char == ")":
+            depth = max(depth - 1, 0)
+        elif char == "{" and (match := _QUANTIFIER.match(string, i)):
+            current.append(match.group())
+            i = match.end()
+            continue
+        elif char == "," and depth == 0:
+            parts.append("".join(current))
+            current = []
+            i += 1
+            continue
+        current.append(char)
+        i += 1
+    parts.append("".join(current))
+    return [part.strip() for part in parts if part.strip()]
+
+
+def _check_regexp_csv(value: list[str] | tuple[str] | str) -> Sequence[str]:
+    """Like `_check_csv`, but keeps commas that belong to a regular expression."""
+    if isinstance(value, (list, tuple)):
+        return value
+    return _split_regexp_csv(value)
+
+
 def _comment(string: str) -> str:
     """Return string as a comment."""
     lines = [line.strip() for line in string.splitlines()]
