diff --git a/tests/config/test_regexp_csv.py b/tests/config/test_regexp_csv.py
new file mode 100644
index 00000000..5824448d
--- /dev/null
+++ b/tests/config/test_regexp_csv.py
@@ -0,0 +1,63 @@
+# Licensed under the GPL: https://www.gnu.org/licenses/old-licenses/gpl-2.0.html
+# For details: https://github.com/pylint-dev/pylint/blob/main/LICENSE
+# Copyright (c) https://github.com/pylint-dev/pylint/blob/main/CONTRIBUTORS.txt
+
+"""Tests for commas inside regular expressions of ``regexp_csv`` options."""
+
+from __future__ import annotations
+
+import argparse
+import re
+from pathlib import Path
+
+import pytest
+
+from pylint.config.argument import _regexp_csv_transfomer
+from pylint.testutils._run import _Run as Run
+
+EMPTY_MODULE = Path(__file__).parent / ".." / "regrtest_data" / "empty.py"
+
+
+def _patterns(value: str) -> list[str]:
+    return [p.pattern for p in _regexp_csv_transfomer(value)]
+
+
+@pytest.mark.parametrize(
+    "value,expected",
+    [
+        ("(foo{1,3})", ["(foo{1,3})"]),
+        ("foo,bar", ["foo", "bar"]),
+        ("(foo{1,3}),bar", ["(foo{1,3})", "bar"]),
+        ("a{1,2},b{2,3}", ["a{1,2}", "b{2,3}"]),
+        ("[a,b],c", ["[a,b]", "c"]),
+        ("foo, bar", ["foo", "bar"]),
+        ("foo,bar,", ["foo", "bar"]),
+        ("", []),
+    ],
+)
+def test_regexp_csv_splitting(value: str, expected: list[str]) -> None:
+    assert _patterns(value) == expected
+
+
+def test_regexp_csv_invalid_regex_still_errors() -> None:
+    with pytest.raises(argparse.ArgumentTypeError):
+        _regexp_csv_transfomer("(foo")
+
+
+def test_regexp_csv_list_passthrough() -> None:
+    compiled = [re.compile("a"), re.compile("b,c")]
+    assert list(_regexp_csv_transfomer(compiled)) == compiled  # type: ignore[arg-type]
+
+
+def test_cli_bad_names_rgxs_with_comma() -> None:
+    runner = Run(
+        ["--bad-names-rgxs=(foo{1,3})", str(EMPTY_MODULE)], exit=False
+    )
+    assert [p.pattern for p in runner.linter.config.bad_names_rgxs] == ["(foo{1,3})"]
+
+
+def test_toml_bad_names_rgxs_with_comma(tmp_path: Path) -> None:
+    config = tmp_path / "pyproject.toml"
+    config.write_text('[tool.pylint.basic]\nbad-names-rgxs = "(foo{1,3})"\n')
+    runner = Run(["--rcfile", str(config), str(EMPTY_MODULE)], exit=False)
+    assert [p.pattern for p in runner.linter.config.bad_names_rgxs] == ["(foo{1,3})"]
