      { "id": "refresh", "method": "POST", "path": "/api/collections/_superusers/auth-refresh?fields=record.collectionName", "headers": { "Authorization": "bearer {{superuser_token}}" },
        "expect": { "status": 200, "paths": { "record.collectionName": "_superusers" } } } ] },
